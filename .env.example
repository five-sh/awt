# Sample awt config. Every variable is optional; the values below are the
# defaults. awt reads these from your shell environment, not from this file,
# so export the ones you want to change (e.g. in ~/.zshrc).

# Name of the tmux session you attach to. Parked windows go in "<name>-park".
AWT_SESSION=awt

# Bare clones, used as the source for new worktrees.
AWT_REPOS_ROOT=~/awt/repos

# Where worktrees are checked out, as <repo>/<worktree>.
AWT_WORKSPACE_ROOT=~/awt/workspaces

# Editor run in each worktree's edit pane.
EDITOR=nvim
